# Neon / PostgreSQL connection string (pooled for serverless runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/oneatlas?sslmode=require"

# Direct connection string for Prisma migrations (recommended for Neon)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/oneatlas?sslmode=require"

# Optional API key for POST /api/v1/ingest (leave empty in local dev to allow unauthenticated ingestion)
INGEST_API_KEY=""
